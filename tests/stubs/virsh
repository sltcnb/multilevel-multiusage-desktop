#!/bin/sh
# Test stub for virsh. Records every invocation to $STUB_LOG and answers the
# subcommands the appliance scripts actually use. State (which nets/domains
# "exist") lives as marker files under $STUB_STATE so idempotency can be tested.
: "${STUB_LOG:=/tmp/stub.log}"; : "${STUB_STATE:=/tmp/stub-state}"
mkdir -p "$STUB_STATE"
printf 'virsh %s\n' "$*" >> "$STUB_LOG"

# Strip the -q/--quiet flag some callers pass before the subcommand.
while [ "${1:-}" = "-q" ] || [ "${1:-}" = "--quiet" ]; do shift; done
cmd="${1:-}"; shift 2>/dev/null || true

case "$cmd" in
  net-info)   [ -f "$STUB_STATE/net-$1" ] || exit 1 ;;
  net-define) # arg is an XML file; remember the <name> it defines
              n="$(sed -n 's:.*<name>\(.*\)</name>.*:\1:p' "$1" | head -1)"
              cp "$1" "$STUB_STATE/netxml-$n"; touch "$STUB_STATE/net-$n" ;;
  net-start|net-autostart|net-destroy|net-undefine) : ;;
  dominfo)    [ -f "$STUB_STATE/dom-$1" ] || exit 1 ;;
  domstate)   # "shut off" unless the test marked the domain running.
              [ -f "$STUB_STATE/dom-$1" ] || exit 1
              if [ -f "$STUB_STATE/running-$1" ]; then echo "running"; else echo "shut off"; fi ;;
  define)     # reads domain XML on stdin (/dev/stdin)
              cat > "$STUB_STATE/domxml-defined"
              n="$(sed -n 's:.*<name>\(.*\)</name>.*:\1:p' "$STUB_STATE/domxml-defined" | head -1)"
              [ -n "$n" ] && { cp "$STUB_STATE/domxml-defined" "$STUB_STATE/domxml-$n"; touch "$STUB_STATE/dom-$n"; } ;;
  start|autostart|destroy|undefine|secret-define|secret-set-value) : ;;
  list)       for f in "$STUB_STATE"/dom-*; do
                [ -e "$f" ] || continue; basename "$f" | sed 's/^dom-//'
              done ;;
  domblklist) d="$1"
              printf ' Target   Source\n----------------------------\n'
              [ -f "$STUB_STATE/blk-$d" ] && cat "$STUB_STATE/blk-$d" ;;
  detach-disk) d="$1"; t="$2"
              # STUB_DETACH_FAIL=1 simulates libvirt refusing the detach: the
              # domain keeps referencing the disk.
              [ "${STUB_DETACH_FAIL:-0}" = "1" ] && exit 1
              [ -f "$STUB_STATE/blk-$d" ] && { grep -v "^ *$t " "$STUB_STATE/blk-$d" > "$STUB_STATE/blk-$d.new"; mv "$STUB_STATE/blk-$d.new" "$STUB_STATE/blk-$d"; } ;;
  attach-device|detach-device) cat >/dev/null 2>&1 || true ;;
  set-user-password) : ;;
  qemu-agent-command)
              # $1 = domain, $2 = JSON. Behaviour driven by $STUB_AGENT:
              #   down  -> agent unreachable
              #   slow  -> never reports "exited":true (tests the poll timeout)
              #   up    -> a simulated guest: pings to the internet succeed,
              #            pings to a peer environment's gateway return
              #            $STUB_PEER_RC (default 1 = blocked, i.e. isolated).
              #            Set STUB_PEER_RC=0 to simulate an isolation BREACH.
              #
              # The "up" guest also has a small real filesystem under
              # $STUB_STATE/gfs-<domain>/ so the PA-114 diode (environments/
              # diode.sh) can be tested end to end: the guest-file-open/read/
              # write/close API and the ls/mkdir/rm/test guest-exec commands the
              # diode uses operate on that tree, so a file placed in a "source"
              # guest's outbox really does land in the "destination" guest's inbox.
              dom="$1"; j="$2"
              # gfs_real <guest-absolute-path> -> host path inside the fake guest FS.
              gfs_real() { printf '%s/gfs-%s%s' "$STUB_STATE" "$dom" "$1"; }
              case "${STUB_AGENT:-up}" in
                down) exit 1 ;;
                slow) case "$j" in *guest-exec-status*) echo '{"return":{"exited":false}}';;
                                   *) echo '{"return":{"pid":1234}}';; esac ;;
                *)    case "$j" in
                        *guest-file-open*)
                          p="$(printf '%s' "$j" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')"
                          m="$(printf '%s' "$j" | sed -n 's/.*"mode":"\([^"]*\)".*/\1/p')"
                          rp="$(gfs_real "$p")"
                          case "$m" in
                            w*) mkdir -p "$(dirname "$rp")" 2>/dev/null; : > "$rp" ;;
                            *)  [ -f "$rp" ] || { echo '{"error":{"class":"GenericError","desc":"no such file"}}'; exit 0; } ;;
                          esac
                          h="$(cat "$STUB_STATE/gfseq" 2>/dev/null || echo 100)"; h=$((h+1)); echo "$h" > "$STUB_STATE/gfseq"
                          printf '%s' "$rp" > "$STUB_STATE/gfh-$dom-$h"
                          echo 0 > "$STUB_STATE/gfo-$dom-$h"
                          printf '{"return":%s}\n' "$h" ;;
                        *guest-file-write*)
                          h="$(printf '%s' "$j" | sed -n 's/.*"handle":\([0-9]*\).*/\1/p')"
                          b="$(printf '%s' "$j" | sed -n 's/.*"buf-b64":"\([^"]*\)".*/\1/p')"
                          rp="$(cat "$STUB_STATE/gfh-$dom-$h" 2>/dev/null)"
                          cnt=0
                          if [ -n "$rp" ]; then
                            printf '%s' "$b" | base64 -d >> "$rp" 2>/dev/null
                            cnt="$(printf '%s' "$b" | base64 -d 2>/dev/null | wc -c | tr -d ' ')"
                          fi
                          printf '{"return":{"count":%s,"eof":false}}\n' "${cnt:-0}" ;;
                        *guest-file-read*)
                          h="$(printf '%s' "$j" | sed -n 's/.*"handle":\([0-9]*\).*/\1/p')"
                          c="$(printf '%s' "$j" | sed -n 's/.*"count":\([0-9]*\).*/\1/p')"; : "${c:=4096}"
                          rp="$(cat "$STUB_STATE/gfh-$dom-$h" 2>/dev/null)"
                          off="$(cat "$STUB_STATE/gfo-$dom-$h" 2>/dev/null || echo 0)"
                          sz="$(wc -c < "$rp" 2>/dev/null || echo 0)"
                          chunk="$(mktemp)"
                          dd if="$rp" of="$chunk" bs=1 skip="$off" count="$c" 2>/dev/null
                          got="$(wc -c < "$chunk" | tr -d ' ')"
                          b64="$(base64 < "$chunk" | tr -d '\n')"; rm -f "$chunk"
                          off=$((off+got)); echo "$off" > "$STUB_STATE/gfo-$dom-$h"
                          eof=false; [ "$off" -ge "$sz" ] 2>/dev/null && eof=true
                          printf '{"return":{"count":%s,"buf-b64":"%s","eof":%s}}\n' "$got" "$b64" "$eof" ;;
                        *guest-file-close*)
                          h="$(printf '%s' "$j" | sed -n 's/.*"handle":\([0-9]*\).*/\1/p')"
                          rm -f "$STUB_STATE/gfh-$dom-$h" "$STUB_STATE/gfo-$dom-$h" 2>/dev/null
                          echo '{"return":{}}' ;;
                        *guest-exec-status*)
                          pid="$(printf '%s' "$j" | sed -n 's/.*"pid":\([0-9]*\).*/\1/p')"
                          # A diode fs command had its exit code + stdout computed
                          # at exec time; return them (out-data base64). Everything
                          # else keeps the ping-target rc logic isolate.sh relies on.
                          if [ -f "$STUB_STATE/pidrc-$pid" ]; then
                            rc="$(cat "$STUB_STATE/pidrc-$pid")"
                            od="$(base64 < "$STUB_STATE/pidout-$pid" 2>/dev/null | tr -d '\n')"
                            printf '{"return":{"exitcode":%s,"out-data":"%s","exited":true}}\n' "$rc" "$od"
                          else
                            tgt="$(cat "$STUB_STATE/pid-$pid" 2>/dev/null || echo '')"
                            case "$tgt" in
                              *10.10.*) rc="${STUB_PEER_RC:-1}" ;;   # peer env gateway
                              *)        rc="${STUB_WAN_RC:-0}"  ;;   # the internet
                            esac
                            printf '{"return":{"exitcode":%s,"exited":true}}\n' "$rc"
                          fi ;;
                        *)
                          n="$(cat "$STUB_STATE/pidseq" 2>/dev/null || echo 1000)"
                          n=$((n+1)); echo "$n" > "$STUB_STATE/pidseq"
                          printf '%s' "$j" > "$STUB_STATE/pid-$n"
                          # Recognise the diode's own fs commands and run them for
                          # real against the fake guest FS, stashing rc + stdout.
                          cmd="$(printf '%s' "$j" | sed -n 's/.*"-c","\(.*\)"\],"capture-output.*/\1/p')"
                          gp="$(printf '%s' "$cmd" | sed -n "s/[^']*'\([^']*\)'.*/\1/p")"
                          rp=""; [ -n "$gp" ] && rp="$(gfs_real "$gp")"
                          w="${cmd%% *}"
                          case "$w" in
                            ls)    ls -1 -- "$rp" 2>/dev/null > "$STUB_STATE/pidout-$n" || : > "$STUB_STATE/pidout-$n"; echo 0 > "$STUB_STATE/pidrc-$n" ;;
                            mkdir) mkdir -p -- "$rp" 2>/dev/null; : > "$STUB_STATE/pidout-$n"; echo 0 > "$STUB_STATE/pidrc-$n" ;;
                            rm)    rm -f -- "$rp" 2>/dev/null; : > "$STUB_STATE/pidout-$n"; echo 0 > "$STUB_STATE/pidrc-$n" ;;
                            test)  if [ -e "$rp" ]; then printf 'EXISTS' > "$STUB_STATE/pidout-$n"; else : > "$STUB_STATE/pidout-$n"; fi; echo 0 > "$STUB_STATE/pidrc-$n" ;;
                            *)     : ;;   # ping / cloud-init / other: fall back to target rc logic
                          esac
                          printf '{"return":{"pid":%s}}\n' "$n" ;;
                      esac ;;
              esac ;;
  *) : ;;
esac
exit 0
