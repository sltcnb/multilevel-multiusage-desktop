# Local, machine-specific config — holds SECRETS (guest password, WiFi PSK,
# LUKS passphrase, WireGuard private keys). NEVER commit. Commit only the
# template config.env.example.
config.env
# Backups the wizard makes before rewriting config.env — same secrets.
config.env.bak-*

# Build outputs / disk images (large, generated)
out/
*.qcow2
*.raw
*.img

# Downloaded base cloud images / build cache
base-*.img
base-*.qcow2
*-seed.iso

# Temp / OS cruft
*.tmp
*.part
.DS_Store


# guest agent artifacts + stray screenshots
*.pkg
docs/img/
