# config.env.example
# -----------------------------------------------------------------------------
# This file is a template. The scripts (starting with src/host.sh detect-and-install)
# auto-detect hardware and WRITE the real values into ./config.env, which every
# later script sources. You normally do NOT edit config.env by hand — but any
# value below can be overridden by exporting it before running the scripts, or
# by editing config.env after it is generated.
#
# All values here are OVERRIDABLE TUNABLES. Auto-detected values are marked.
# -----------------------------------------------------------------------------

# --- Disk encryption (OPTIONAL, EXPERIMENTAL) --------------------------------
# ENCRYPT=1 makes src/host.sh install-to-disk do a LUKS2 encrypted install (root
# encrypted at rest; passphrase entered at each boot). Default 0 = plaintext
# dd-clone (fast, well-tested). Test ENCRYPT=1 on a spare/VM before relying on
# it — a bad encrypted install can be unbootable. TPM2 auto-unlock is a TODO.
ENCRYPT=0
LUKS_PASS=""          # REQUIRED when ENCRYPT=1. Sensitive — an image with this
                      # baked in is a secret; prefer setting it on the appliance.

# --- Paths -------------------------------------------------------------------
# Where VM disk images live. Auto-detected in src/host.sh detect-and-install (defaults to libvirt default).
IMAGES_DIR="/var/lib/libvirt/images"
# Where downloaded cloud images / ISOs are cached.
CACHE_DIR="/var/cache/appliance-build"

# --- Hardware (AUTO-DETECTED — do not hardcode; shown here for reference) -----
# CPU_VENDOR      -> "intel" or "amd"        (from /proc/cpuinfo)
# KVM_MODULE      -> "kvm_intel" or "kvm_amd"
# NESTED_PARAM    -> module param line for nested virt
# TOTAL_CORES     -> nproc
# TOTAL_RAM_MB    -> /proc/meminfo MemTotal
# DISK_FREE_MB    -> free space on IMAGES_DIR filesystem

# --- Host headroom (OVERRIDABLE) ---------------------------------------------
# RAM/cores/disk reserved for the host itself, never given to VMs.
HOST_RESERVE_RAM_MB=2048
HOST_RESERVE_CORES=1
HOST_RESERVE_DISK_MB=4096     # 4 GiB kept free on IMAGES_DIR for the host
                              # (keep small; VM storage should live on a big
                              # disk via IMAGES_DIR, not the boot USB)
# Warn if free disk on IMAGES_DIR drops below this (MB).
DISK_LOW_WATERMARK_MB=40960   # 40 GiB

# =============================================================================
# ENVIRONMENTS (the VMs). Ordered list; position (1-based) fixes each env's
# workspace number, /24 subnet and bridge, so enabling/disabling one never
# renumbers the others. English names: office / development / administration
# (bureautique / développement / administration).
# =============================================================================
ENVS="office development administration"
SUBNET_BASE="10.10"          # env at index i uses ${SUBNET_BASE}.i.0/24

# Per-env settings ------------------------------------------------------------
#   <env>_ENABLED  1|0   create + show this environment?
#   <env>_OS       ubuntu|arch|debian   guest OS. NOTE: the office/desktop env
#                  MUST be ubuntu (Intune/Entra enrollment is Ubuntu-only).
#   <env>_DE       xfce4|gnome|kde|mate|lxqt|none   desktop env (all distros;
#                  cloud-init installs it + display manager + autologin). "none"=CLI.
#   <env>_EGRESS_MODE  all|whitelist ; <env>_EGRESS_ALLOW "ip ip"
#   <env>_INTUNE   1  (Ubuntu only) install MS Intune portal for Entra enrollment
#   <env>_MSAPPS   1  install Outlook + Teams as Edge PWAs (Conditional-Access ok)
#   <env>_WAZUH    1  install + enroll the Wazuh agent (needs WAZUH_MANAGER below)
#   <env>_NETBIRD  1  install + enroll the NetBird mesh VPN agent (needs NETBIRD_SETUP_KEY below)

# office = bureautique (daily desktop). Windows 11 for FIRST-CLASS Entra ID join
# + Intune MDM and native Teams/Outlook/M365. Requires a Windows 11 install ISO
# you supply (WINDOWS_ISO, further down) — this repo can neither download nor
# license Windows. Windows installs unattended from that ISO (q35 + UEFI + vTPM;
# ~20-40 min on first create). Prefer the lighter Linux path? Set
# office_OS="ubuntu" and office_DE="gnome" (Intune there is the limited
# intune-portal client).
office_ENABLED=1
office_OS="windows"
office_DE="none"                  # ignored for Windows (it ships its own desktop)
office_VCPU=2                     # Win11 wants >= 2 vCPU ...
office_RAM_MB=4096                # ... and >= 4 GB RAM (RAM is NOT auto-split)
office_DISK_GB=64                 # Win11 needs a large disk (see AUTO_DISK note below)
office_EGRESS_MODE="all";          office_EGRESS_ALLOW=""
office_INTUNE=1                    # Entra join + Intune enrollment: native MDM, done interactively after first boot
office_MSAPPS=1                    # Windows: install M365/Teams via Intune/Company Portal post-enroll (the Edge-PWA path is Linux-only)

# development = développement. Arch by default; monitored by Wazuh, on the
# NetBird mesh VPN.
development_ENABLED=1
development_OS="arch"
development_DE="gnome"
development_EGRESS_MODE="all";     development_EGRESS_ALLOW=""
development_WAZUH=1
development_NETBIRD=1

# administration = administration (sensitive). Arch; monitored by Wazuh.
# Egress is WHITELISTED by default (T-10 / SO-6): an administration domain must
# NOT have open internet — the standard prohibits web browsing from it. Only DNS
# (to its gateway) plus the hosts listed below are reachable; everything else is
# dropped. Add the update mirrors / management endpoints this domain genuinely
# needs to EGRESS_ALLOW; keep it minimal.
administration_ENABLED=1
administration_OS="arch"
administration_DE="gnome"
administration_EGRESS_MODE="whitelist";  administration_EGRESS_ALLOW="1.1.1.1 8.8.8.8"
administration_WAZUH=1
administration_NETBIRD=1
# NOTE: administration egress is WHITELISTED, but NetBird needs its
# management/signal/relay endpoints reachable — `netbird up` will fail here
# until you ADD those to administration_EGRESS_ALLOW. NetBird's hosted relays
# use dynamic IPs, so a whitelisted domain is far easier with a SELF-HOSTED
# control plane at a fixed address (set NETBIRD_MANAGEMENT_URL and allow its IP).

# Wazuh manager (server) IP/hostname — REQUIRED for any env with <env>_WAZUH=1.
WAZUH_MANAGER=""

# --- NetBird (mesh VPN) — REQUIRED for any env with <env>_NETBIRD=1 ----------
# NETBIRD_SETUP_KEY: a setup key issued by your NetBird dashboard (or self-hosted
# `netbird` control plane). SECRET — embedded in the guest's cloud-init seed to
# run `netbird up`, then blanked from config.env by scrub-secrets once consumed.
NETBIRD_SETUP_KEY=""
# NETBIRD_MANAGEMENT_URL: only for a SELF-HOSTED NetBird control plane, e.g.
# https://netbird.example.com:33073 . Empty = NetBird's hosted service.
NETBIRD_MANAGEMENT_URL=""

# --- Per-env dedicated, non-bypassable VPN (ANSSI #8) — OPT-IN, EXPERIMENTAL --
# Set <env>_VPN=1 and fill the WireGuard fields, then run src/environments.sh vpn.
# The tunnel is enforced on the HOST (policy routing + nftables), so the guest
# cannot disable/bypass it. Needs a real WireGuard peer + on-hardware testing.
# PRIVKEY is SENSITIVE — prefer setting these on the appliance, not in the image.
#   <env>_VPN=1
#   <env>_VPN_PRIVKEY="<host private key>"
#   <env>_VPN_ADDRESS="10.9.<idx>.2/32"
#   <env>_VPN_PUBKEY="<peer/gateway public key>"
#   <env>_VPN_ENDPOINT="vpn.example.com:51820"
#   <env>_VPN_ALLOWED="0.0.0.0/0"     # full tunnel
office_VPN=0
development_VPN=0
administration_VPN=0

# --- Inter-domain file diodes (ANSSI-PA-114 §3.18) — OPT-IN ------------------
# By DEFAULT the environments cannot exchange ANYTHING (isolate.sh drops every
# ordered subnet pair) — that IS the PA-114 default ("Les communications entre
# domaines utilisateurs sont proscrites"). PA-114 §3.18 permits ONE narrow,
# OPTIONAL exception: a DIODE — a unidirectional, mediated, logged transfer of
# FILES between two identified domains. It is NOT a network route: the socle
# reads the file from the source VM, you accept it, and it is written into the
# destination VM — all over the guest-agent channel, so the guests still have no
# path to each other and the isolation ruleset is untouched. Run it with
# src/environments.sh diode (setup.sh step 11). Leave DIODES empty to
# keep inter-domain exchange fully blocked.
#
# DIODES: space-separated SRC>DST pairs. Each is ONE unidirectional diode; list
# both "a>b" and "b>a" only if you truly need exchange in both directions (each
# stays independently mediated + logged). Example — push down from the sensitive
# admin domain, and from dev to office:
#   DIODES="administration>development administration>office development>office"
DIODES=""
# In the SOURCE guest, drop files to send in:  ~/diode-out/<destination-env>/
# In the DESTINATION guest, they arrive in:    ~/diode-in/<source-env>/
DIODE_OUTBOX="diode-out"
DIODE_INBOX="diode-in"
DIODE_MAX_BYTES=8388608          # per-file ceiling (8 MiB) — a diode moves docs
# §3.18.6 optional content vetting on the host copy before delivery. DIODE_SCAN=1
# runs the deny-list below and, if installed, clamav; a hit REFUSES the file.
# §3.18.7's stricter "dedicated support domain per diode" is a documented harden.
DIODE_SCAN=0
DIODE_SCAN_DENYLIST=""           # space-separated egrep patterns, e.g. "SECRET CONFIDENTIEL"
# Per-env base dir override (default /home/$GUEST_USER). A non-Linux domain
# (e.g. a Windows office VM) sets its own path, e.g.:
#   office_DIODE_DIR="C:/Users/operator"

# --- Disk auto-split ---------------------------------------------------------
# AUTO_DISK=1 (default): 01 splits detected free space evenly across the ENABLED
#   envs (qcow2 thin -> these are MAX virtual sizes). AUTO_DISK=0 uses the fixed
#   per-env size below (or a per-env <env>_DISK_GB override).
# WINDOWS NOTE: a Windows 11 env needs >= ~64 GB. If AUTO_DISK=1 would split the
#   disk into shares smaller than that, either set AUTO_DISK=0 with
#   FIXED_DISK_GB=64+ (honors the per-env office_DISK_GB above), or give the host
#   a large enough disk that each share clears 64 GB. create.sh warns if the
#   Windows env's disk is too small to install.
AUTO_DISK=1
FIXED_DISK_GB=30             # used per env only when AUTO_DISK=0

# --- Per-env user-keyed disk encryption (ANSSI) — OPT-IN, EXPERIMENTAL --------
# <env>_ENCRYPT_DISK=1 makes that VM's disk a LUKS-encrypted qcow2, unlocked by
# <env>_DISK_PASS (a secret the user knows). libvirt holds the secret to start
# the domain; scrub-secrets.sh blanks <env>_DISK_PASS from config afterward.
#   <env>_ENCRYPT_DISK=1
#   <env>_DISK_PASS="a-strong-per-env-passphrase"
office_ENCRYPT_DISK=0
development_ENCRYPT_DISK=0
administration_ENCRYPT_DISK=0

# --- USB peripheral lockdown (ANSSI #9) (OVERRIDABLE) ------------------------
# 1 = enable usbguard (default-deny USB; allow-policy generated on first boot so
#     built-in keyboard/trackpad keep working). Bind a device to one VM at a time
#     with `virsh attach-device`. 0 = off (hot-plug USB works freely).
# WARNING: with 1, a USB device plugged AFTER first boot is blocked until allowed
# (`usbguard list-devices` / `usbguard allow-device <id>`).
USBGUARD=1

# --- YubiKey -> VM routing (OVERRIDABLE) -------------------------------------
# 1 = on plug you CHOOSE which VM gets the YubiKey; it is USB-passed-through to
#     ONLY that env (detached from any other first — never shared across envs).
#     usbguard is told to admit Yubico (vendor 1050); a udev rule pops the chooser
#     on insert; Super+y re-runs it manually. Needs USBGUARD=1 to matter.
# 0 = no special YubiKey handling.
YUBIKEY_ROUTER=1

# --- Host (socle) hardening (ANSSI #2) (OVERRIDABLE) -------------------------
# Kernel sysctl hardening is always applied by src/host.sh harden. The host INPUT
# firewall (default-drop everything TO the host) is opt-in so it can't lock out
# an SSH you use during setup.
HARDEN_INPUT=0        # 1 = default-drop host INPUT (socle exposes no services)
HOST_SSH=0            # 1 = keep sshd reachable (port 22) when HARDEN_INPUT=1

# --- Trust bar (ANSSI barre de confiance) (OVERRIDABLE) ----------------------
# 1 = always-visible top bar showing the active environment (color-coded);
#     guests tile below it so it can't be hidden. ANSSI requires the user to
#     always know which environment is active.
# 0 = guests go true fullscreen edge-to-edge, no persistent bar.
TRUST_BAR=1

# --- Continuous isolation watch (OVERRIDABLE) --------------------------------
# src/environments.sh isolate proves the inter-env DROP rules exist ONCE, at setup.
# src/host.sh isolation-watch keeps proving it: on a schedule it asserts every
# ordered environment pair still has its DROP rule live in the kernel, and
# publishes the verdict to /run/appliance/isolation.status (one TAB-separated
# "STATE EPOCH DETAIL" line; OK|FAIL|UNKNOWN — gone after a reboot = UNKNOWN,
# never a stale OK). Only state TRANSITIONS are written to the audit log.
# Installed automatically by isolate.sh.
#   ISOLATION_WATCH=0         -> do NOT install the recurring check. Nothing
#                                will then notice if the ruleset is flushed
#                                after setup.
#   ISOLATION_WATCH_INTERVAL  -> seconds between checks. On the appliance
#                                (busybox crond) anything below a minute is
#                                rounded UP to a whole minute; on a systemd
#                                host the exact value is honoured.
ISOLATION_WATCH=1
ISOLATION_WATCH_INTERVAL=60

# --- In-place appliance updates (src/host.sh update) (OVERRIDABLE) ---------------
# Without this, shipping a fix to a deployed machine means rebuilding the
# image, reflashing a stick and losing every VM. src/host.sh update replaces the
# /opt/appliance CODE tree only: config.env, the installer/first-boot markers
# and all VM storage are machine state and are carried across untouched. The
# new tree is downloaded, verified and syntax-checked BEFORE it is swapped in
# (an atomic rename), and previous trees are kept for --rollback.
# SIGNATURES ARE MANDATORY: with UPDATE_GPG_FPR empty the update is REFUSED
# (fail closed) — "download and run as root" with no verification is a remote
# root shell for whoever can answer the URL. UPDATE_INSECURE=1 is the escape
# hatch; it is NOT a supported configuration.
UPDATE_CHANNEL="tarball"  # tarball | git
# tarball channel: the release archive; its detached signature must sit at
# UPDATE_URL + ".sig" next to it.
UPDATE_URL=""
# Pinned fingerprint of the release signing key. REQUIRED — empty refuses the
# update (fail closed). Unlike <OS>_IMG_GPG_FPR this is not tri-state: leaving
# it empty is the safe default, not an error.
UPDATE_GPG_FPR=""
UPDATE_GPG_KEYRING=""     # optional keyring file holding that key, placed
                          # out of band (preferred over the default keyring)
# git channel: fetch UPDATE_GIT_REF (a signed tag, or a branch/commit whose
# tip commit is signed) from UPDATE_GIT_REMOTE and verify it against the pin.
UPDATE_GIT_REMOTE=""
UPDATE_GIT_REF="main"
UPDATE_INSECURE=0         # 1 = install UNVERIFIED code as root (dangerous)
UPDATE_KEEP_BACKUPS=3     # previous trees kept for --rollback (minimum 1)
UPDATE_REPROVISION=1      # 1 = re-run the host scripts after the swap so the
                          #     new code takes effect; 0 = swap only
UPDATE_REQUIRE_VMS_OFF=0  # 1 = refuse to update while any VM is running

# --- Guest OS variants + image URLs (OVERRIDABLE) ----------------------------
# Run `osinfo-query os` for valid --os-variant values.
UBUNTU_OS_VARIANT="ubuntu22.04"
ARCH_OS_VARIANT="archlinux"
DEBIAN_OS_VARIANT="debian12"
WINDOWS_OS_VARIANT="win11"

# --- Windows 11 office guest (only when an env sets <env>_OS="windows") -------
# REQUIRED: absolute path to a Windows 11 install ISO you provide. There is no
# free/licensed Windows image to download, so this has NO default and create.sh
# fails closed with guidance if a windows env is enabled without it.
WINDOWS_ISO=""                    # e.g. /opt/appliance/images/Win11_x64.iso
# virtio-win (drivers + qemu-guest-agent) and the SPICE guest tools (auto-resize)
# ARE freely redistributable and are fetched automatically; pin/override only if
# you mirror them internally.
# VIRTIO_WIN_URL="https://.../virtio-win.iso"
# VIRTIO_WIN_SHA256="<64-hex>"    # optional integrity pin (same model as *_IMG_SHA256)
# SPICE_GUEST_TOOLS_URL="https://www.spice-space.org/download/windows/spice-guest-tools/spice-guest-tools-latest.exe"
# WIN_LOCALE="en-US"              # Windows install locale
# WIN_TZ="UTC"                    # Windows time zone id

# --- Base image source directories (OVERRIDABLE) -----------------------------
# <OS>_IMG_DATE pins the DATED directory each vendor publishes next to its
# rolling one. The rolling paths ("current"/"latest") re-point at a new build
# every few weeks, which is exactly why hand-pinned hashes went stale and
# operators stopped pinning at all. A dated directory is immutable, so a hash
# (or a vendor signature) pinned against it keeps verifying until YOU move it.
# Empty (default) = today's rolling behaviour. Use the vendor's own directory
# name, verbatim — they don't agree on a format:
#   UBUNTU_IMG_DATE="20260701"        -> .../jammy/20260701/
#   DEBIAN_IMG_DATE="20260722-2547"   -> .../bookworm/20260722-2547/
#   ARCH_IMG_DATE="v20260715.556894"  -> .../images/v20260715.556894/
UBUNTU_IMG_DATE=""
ARCH_IMG_DATE=""
DEBIAN_IMG_DATE=""

# --- Base image integrity pinning (OPTIONAL, recommended) --------------------
# src/environments.sh create downloads the base cloud images above over plain
# HTTPS with no signature check of its own. Pinning is OPTIONAL by default:
#   * leave everything empty -> that image is downloaded WITHOUT an integrity
#                            check (a warning is printed).
#   * set <OS>_IMG_GPG_FPR -> the vendor's OWN signature is verified against
#                            that exact key on every run (see below); it
#                            survives vendor rebuilds, so it never goes stale.
#   * set <OS>_IMG_SHA256  -> STRICT verification of one exact build; a mismatch
#                            deletes the file and ABORTS (fail closed). A
#                            hand-pinned hash WINS when both are set (it pins
#                            WHICH build, not just who signed it) — pair it with
#                            <OS>_IMG_DATE above or it goes stale on the next
#                            vendor rebuild.
#   * REQUIRE_IMG_SHA256=1 -> a missing pin becomes a hard error (mandate pinning
#                            for every OS an ENABLED env actually uses).
# Recommended: pin every image you use, one way or the other.
#   1. Fetch the vendor's own published checksums (ideally over a path/network
#      independent from this host) and verify THEIR signature before trusting
#      them (or skip this entirely by using <OS>_IMG_GPG_FPR instead):
#        Ubuntu:  https://cloud-images.ubuntu.com/jammy/current/SHA256SUMS
#                 (+ SHA256SUMS.gpg, signed by Canonical's image key)
#        Arch:    https://geo.mirror.pkgbuild.com/images/latest/sha256sums.txt
#                 (+ .sig, signed by the Arch Linux release key)
#        Debian:  https://cloud.debian.org/images/cloud/bookworm/latest/SHA256SUMS
#                 (+ SHA256SUMS.sign, signed by the Debian cloud image key)
#   2. Paste the matching 64-hex-char digest below.
UBUNTU_IMG_SHA256=""
ARCH_IMG_SHA256=""
DEBIAN_IMG_SHA256=""

# T-12 / SO-7: pinning is MANDATORY by default — an unpinned, unverified base
# image downloaded over the network and booted as your workstation is a
# supply-chain foothold. With this set to 1, create.sh REFUSES to build any
# enabled env whose OS image has neither a <OS>_IMG_SHA256 nor a <OS>_IMG_GPG_FPR
# (below). Pin each OS you use — the SHA above (exact build) OR, preferred, the
# vendor signing-key fingerprint below (survives vendor rebuilds) — before the
# first build. Set to 0 ONLY for a throwaway lab where you accept an unverified
# image (create.sh then only warns).
REQUIRE_IMG_SHA256="1"

# --- Vendor-signature verification of the base images (OPTIONAL, preferred) --
# <OS>_IMG_GPG_FPR makes create.sh fetch what the vendor signed and refuse it
# unless the signature was made by EXACTLY the pinned key (a bare gpg --verify
# accepts a good signature from ANY key — the fingerprint comparison is what
# gates trust). TRI-STATE, on purpose:
#   * NOT SET (line absent/commented) -> feature off; unverified download + a
#                                        warning. This is the default.
#   * set to a 40-hex fingerprint     -> STRICT: a missing/bad/foreign
#                                        signature deletes the image and aborts.
#   * set to EMPTY ("")               -> REFUSED: blanking a pin is never a
#                                        quiet downgrade path.
#   => NEVER write <OS>_IMG_GPG_FPR="" — to keep the feature off, leave the
#   line out or commented, exactly as shown below.
# NO DEFAULTS ARE SHIPPED: a fingerprint baked into this repo would just move
# the trust problem into git. Obtain each vendor's key fingerprint out of band
# (vendor documentation over an independent path, a distro keyring package):
#   Ubuntu: Canonical cloud-image signing key  (cloud-images.ubuntu.com docs)
#   Debian: Debian cloud-images signing key    (wiki.debian.org/Cloud/)
#   Arch:   the Arch developer key that signed the image (see the .sig)
# UBUNTU_IMG_GPG_FPR="<canonical cloud-image signing key fingerprint>"
# ARCH_IMG_GPG_FPR="<arch release signing key fingerprint>"
# DEBIAN_IMG_GPG_FPR="<debian cloud image signing key fingerprint>"
# Where the key itself comes from when a fingerprint is pinned:
IMG_GPG_KEYRING=""      # exported vendor key(s) placed here out of band —
                        # PREFERRED: no network trust at all.
IMG_GPG_KEYSERVER="hkps://keyserver.ubuntu.com"   # fallback: --recv-keys BY
                        # FINGERPRINT. Safe only because the fingerprint is the
                        # pin; a hostile keyserver cannot answer with another key.

# --- Pinned GPG fingerprints for in-guest third-party repos (OVERRIDABLE) ----
# Microsoft Intune/Edge and the Wazuh agent are installed inside guests via
# `curl <key-url> | gpg --dearmor`. create.sh pins each vendor's signing-key
# fingerprint and makes the guest verify the ACTUALLY downloaded key against
# it before trusting it (aborts that install on any mismatch — fail closed).
# Defaults below are the vendors' current, well-known, long-lived signing keys
# (independently verified against packages.microsoft.com / packages.wazuh.com).
# Only override if a vendor rotates its key — verify the new fingerprint
# out-of-band first, e.g. via the vendor's own docs over an independent path.
MS_GPG_FPR="BC528686B50D79E339D3721CEB3E94ADBE1229CF"
WAZUH_GPG_FPR="0DCFCA5547B19D2A6099506096B3EE5F29111145"
# NetBird ships NO default here on purpose — this repo will not vouch for a
# fingerprint it has not independently verified. For an apt guest (ubuntu/debian)
# with <env>_NETBIRD=1 you MUST set this, or provisioning fails closed. Fetch the
# key from https://pkgs.netbird.io/debian/public.key over an independent path,
# confirm its fingerprint against NetBird's docs, and pin it here. Arch guests
# use the AUR package (checksummed by its PKGBUILD) and ignore this.
NETBIRD_GPG_FPR=""

# --- Custom APT source for guests (OPTIONAL — ubuntu/debian only) ------------
# Route apt-family guests through your own mirror and/or caching proxy instead
# of hitting public archives directly on every build. Both empty = default
# upstream mirrors (nothing changes). Arch guests ignore these (pacman).
#   APT_MIRROR : base archive mirror URL that REPLACES the distro default
#                (wired via cloud-init apt.primary; covers security/updates too).
#                  Ubuntu e.g. http://mirror.internal/ubuntu
#                  Debian e.g. http://mirror.internal/debian
#   APT_PROXY  : caching HTTP(S) proxy for apt (e.g. apt-cacher-ng on the host,
#                reachable from the isolated net). Applied as the GLOBAL apt
#                proxy, so it also covers the in-guest Microsoft/Wazuh repos.
#                  e.g. http://10.20.30.1:3142
# GPG-fingerprint pinning above still decides WHAT is trusted, so a hostile
# mirror/proxy cannot swap signing keys — these only change WHERE bytes come from.
APT_MIRROR=""
APT_PROXY=""

# --- Host users (OVERRIDABLE) ------------------------------------------------
# The desktop autologins an UNPRIVILEGED user that can only view/launch the VMs
# (member of libvirt/kvm, no sudo). Root is reserved for admin on tty2 (Ctrl+Alt+F2).
KIOSK_USER="kiosk"
# Host keyboard layout for the desktop (X). e.g. us, fr, de, gb, be, ch, es ...
# Optional variant after a colon, e.g. "fr:oss" or "us:intl".
KEYBOARD_LAYOUT="us"
# Root (admin) password on tty2. REQUIRED — secrets are never auto-generated
# (a password you did not choose is a password you cannot know; a generated
# root password locks you out of your own appliance). The shipped image keeps
# root LOCKED; this is what unlocks + sets it on the installed system.
HOST_ROOT_PASSWORD=""

# -----------------------------------------------------------------------------
# SECRETS — ALWAYS EXPLICIT, NEVER AUTO-GENERATED
# Every secret must be a value YOU chose, written here (or by configure.sh).
# An empty secret is a hard error at provisioning, not a random value:
#   HOST_ROOT_PASSWORD  (src/host.sh configure)      root admin password
#   GUEST_PASSWORD      (src/environments.sh create) guest login password
#   LUKS_PASS           (src/host.sh install-to-disk) full-disk LUKS passphrase
#   <env>_DISK_PASS     (src/environments.sh create) per-env LUKS passphrase
#   NETBIRD_SETUP_KEY   (src/environments.sh create) NetBird mesh-VPN setup key
# WireGuard keys (<env>_VPN_PRIVKEY) are NOT random blobs — generate with
# `wg genkey` and set explicitly. All secrets are blanked from
# config.env by src/environments.sh scrub-secrets once consumed.
# -----------------------------------------------------------------------------

# --- Guest credentials (OVERRIDABLE — CHANGE THESE) --------------------------
# Used by cloud-init. Password login enabled for console access via virt-viewer.
GUEST_USER="operator"
# Plaintext here for convenience; scripts hash/pass it to cloud-init. CHANGE IT.
# This is the FALLBACK/global password — used by any env that does not set its
# own (below).
GUEST_PASSWORD="changeme"
# STRONGLY RECOMMENDED: a DISTINCT password per environment. With one shared
# value on all three domains, an attacker who recovers it in the least-trusted
# domain (office) owns the most-trusted one (administration) and root — this is
# the SO-1 "shared secret" pivot in the risk analysis, its single highest
# finding. A per-env value is used if set; otherwise the global above applies.
# Set each to something used NOWHERE else, then let scrub-secrets.sh blank them.
#   office_GUEST_PASSWORD="..."
#   development_GUEST_PASSWORD="..."
#   administration_GUEST_PASSWORD="..."       # the crown jewel — most unique
# SSH password auth inside guests is OFF by default (console/viewer login still
# works; nothing in the appliance SSHes into a guest). Re-enable per env only if
# you truly need it:  <env>_SSH_PWAUTH="1"

# Uplink interface for NAT masquerade. AUTO-DETECTED in src/environments.sh isolate if left "auto".
WAN_IFACE="auto"

# --- Per-env outbound (egress) policy ----------------------------------------
# Set per env above via <env>_EGRESS_MODE / <env>_EGRESS_ALLOW.
#   "all"       = full outbound internet via NAT (default).
#   "whitelist" = only DNS + listed IPs/CIDRs; everything else from that env is
#                 dropped. (names not supported by nftables — use a proxy; see
#                 README design note 1.)

# --- WiFi uplink (OVERRIDABLE; leave SSID empty to keep host on wired) --------
# If WIFI_SSID is non-empty, src/host.sh wifi (and first-boot) will bring up
# WiFi as the host uplink. WAN_IFACE="auto" then resolves to the wlan iface.
# SECURITY: PSK is hashed with wpa_passphrase before writing; plaintext is not
# stored in wpa_supplicant.conf. Still, an image built with these set is
# sensitive — treat it as a secret. Prefer leaving them empty and running 06
# interactively on the appliance.
WIFI_SSID=""
WIFI_PSK=""
WIFI_COUNTRY="FR"          # regulatory domain (ISO 3166-1 alpha-2)
WIFI_IFACE="auto"          # "auto" = first wlan* interface
# Firmware package baked into the image (see 00/01). "linux-firmware" = all
# blobs (safe for unknown NIC); narrow to e.g. linux-firmware-iwlwifi to shrink.
WIFI_FIRMWARE_PKG="linux-firmware"
